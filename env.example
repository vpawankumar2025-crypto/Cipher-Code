# Copy to .env and fill in your OWN values. NEVER commit .env.
#
# SECURITY NOTE: an earlier version of this file (and .env itself) had real,
# live credentials committed to it. If you have ever pushed this repo
# anywhere (GitHub, a shared drive, a zip you sent teammates), treat every
# one of the following as burned and rotate it before demo day:
#   - Gmail App Password (myaccount.google.com/apppasswords)
#   - Twilio Auth Token + API Key/Secret (twilio.com/console)
#   - Google OAuth client secret (console.cloud.google.com)
#   - Microsoft OAuth client secret (Azure AD app registration)
#   - JWT_SECRET_KEY — generate a new one with:
#       python -c "import secrets; print(secrets.token_hex(32))"

JWT_SECRET_KEY=
ADMIN_EMAIL=

# --- Email OTP + alert delivery ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- SMS OTP + alert delivery (Twilio) ---
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=

# --- Google Sign-In ---
GOOGLE_CLIENT_ID=

# --- Direct mailbox connection (OAuth) ---
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/mailbox/callback/google
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_TENANT=common
MS_OAUTH_REDIRECT_URI=http://localhost:8000/api/mailbox/callback/microsoft
MAILBOX_POLL_INTERVAL_MINUTES=3

# --- Real-time alerting on Malicious verdicts ---
ALERTS_ENABLED=true
ALERT_MIN_SCORE=60
ALERT_EMAIL_TO=soc@example.org
ALERT_SMS_TO=

# --- IMAP live ingestion (optional, needs a real inbox) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASS=

# --- Optional real threat-intel ---
VT_API_KEY=

# --- Optional: switch case storage from SQLite to Postgres ---
DATABASE_URL=

# --- Identity printed on CERT-In / cybercrime.gov.in incident reports ---
REPORT_ORG_NAME=
REPORT_ORG_TYPE=Educational Institution
REPORT_CONTACT_NAME=
REPORT_CONTACT_DESIGNATION=IT / Security Administrator
REPORT_CONTACT_EMAIL=
REPORT_CONTACT_PHONE=
REPORT_ORG_ADDRESS=
REPORT_ORG_STATE=
