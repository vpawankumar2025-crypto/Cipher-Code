# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ---- Virtual environments ----
venv/
.venv/
env/
ENV/

# ---- Environment / secrets ----
# Real credentials live only in .env, which must NEVER be committed.
# .env.example (blank placeholders only) is intentionally NOT ignored.
.env
.env.local
.env.*.local
*.pem
*.key

# ---- Databases (local runtime data, not shipped to the repo) ----
*.db
*.db-journal
*.sqlite3
*.sqlite

# ---- Testing / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.tox/
.ruff_cache/

# ---- Logs ----
*.log
logs/

# ---- Jupyter ----
.ipynb_checkpoints/

# ---- Local data dumps / scratch ----
data/
tmp/
*.tmp

# ---- IDE / editor ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Streamlit (if the optional app.py entrypoint is used locally) ----
.streamlit/secrets.toml
